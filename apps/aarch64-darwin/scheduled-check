#!/usr/bin/env bash
# Daily self-healing update pipeline (spec §1), split into two invocation
# modes so the unattended launchd/cron caller can never activate by accident:
#
#   scheduled-check [--propose-only]   (bare invocation == --propose-only)
#     bump (all overlays) -> escalate what broke -> prepare (flake inputs,
#     incl. unpin retry) -> full system build. NEVER activates. On success
#     writes the built revision sha to logs/proposed-revision.
#
#   scheduled-check --activate-only <sha>
#     the privileged tail only: activate <sha> -> health check -> roll back
#     and quarantine on failure -> mirror to public on success.
#
# Why the split exists (do not recombine into one always-activates mode): a
# launchd agent already invokes this script with NO ARGUMENTS on a schedule,
# and the nix registry resolves `nixos-config` to whatever working checkout
# is currently on disk -- which may be an unfinished feature branch. Making
# the no-argument default propose-only means a scheduled run can build and
# report but can never switch the live system; activation can only happen
# through the explicit --activate-only flag, which Task 9's root daemon
# passes deliberately after reviewing (or automating review of) a specific
# committed revision.
#
# Design invariants, in priority order:
#   1. A broken package must not block anything else. Failures are attributed
#      per-package, quarantined at that exact version, and the run continues.
#   2. Nothing is activated without a full system build behind it.
#   3. Nothing is mirrored to the public repo until the health check passes on
#      the machine that produced the revision.
#   4. Silent on success, everywhere, including activation (spec §2
#      "Notification policy" — "You should hear from this system roughly
#      never"). Notifies only when something needs a human: a Claude-authored
#      fix awaiting review, a package newly promoted to frozen, a failed
#      build, or a health-check failure that triggered a rollback. A healthy
#      activation is still recorded in the run log so the event is traceable.
#
# Exit: 0 completed (changes or not) | 1 a failure was reported | 2 lock contention
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/_common.sh"
FLAKE_DIR="$(locate_flake)" || exit 1
# shellcheck source=/dev/null
source "$FLAKE_DIR/scripts/update-notify.sh"
# shellcheck source=/dev/null
source "$FLAKE_DIR/scripts/update-state.sh"
# shellcheck source=/dev/null
source "$FLAKE_DIR/scripts/quarantine.sh"
# shellcheck source=/dev/null
source "$FLAKE_DIR/scripts/classify-failure.sh"
cd "$FLAKE_DIR"

MODE="propose"
ACTIVATE_SHA=""
case "${1:-}" in
  ""|--propose-only)
    if [[ $# -gt 1 ]]; then
      err "usage: scheduled-check [--propose-only] | scheduled-check --activate-only <sha>"
      exit 1
    fi
    MODE="propose"
    ;;
  --activate-only)
    if [[ $# -gt 2 ]]; then
      err "usage: scheduled-check --activate-only <sha> (unexpected trailing arguments: ${*:3})"
      exit 1
    fi
    MODE="activate"
    ACTIVATE_SHA="${2:-}"
    ;;
  *)
    err "usage: scheduled-check [--propose-only] | scheduled-check --activate-only <sha>"
    exit 1
    ;;
esac

# Logs live in the repo (gitignored) so they survive reboots. launchd opens
# StandardOutPath/StandardErrorPath before this runs, so logs/ must already
# exist on disk — a tracked .gitkeep ensures it.
LOG_DIR="$FLAKE_DIR/logs"
mkdir -p "$LOG_DIR" 2>/dev/null || true
# launchd appends to StandardOutPath/StandardErrorPath forever, so truncate
# per-run rather than adding logrotate. BOTH name sets are truncated on
# purpose: hosts/darwin/default.nix currently declares the nixos-update-check
# names (the live ones), and Task 9 renames the agent to nixos-auto-update.
# Truncating a file that does not exist is harmless, and covering both means
# neither name can silently grow unbounded across that rename.
for _log_base in nixos-update-check nixos-auto-update; do
  : > "$LOG_DIR/${_log_base}.out.log" 2>/dev/null || true
  : > "$LOG_DIR/${_log_base}.err.log" 2>/dev/null || true
done
RUN_LOG="$LOG_DIR/nixos-scheduled-check.log"
: > "$RUN_LOG"

quarantine_init

# This script is the FOURTH writer of overlays/quarantine.json (after
# bump-overlays, prepare and escalate.sh, each of which has its own identical
# commit_ledger). The ledger lives under overlays/, and bump-overlays refuses
# to start when overlays/ is dirty (exit 3) — so quarantine_init above, plus
# the quarantine_record calls on the build-failure and health-failure paths,
# would otherwise leave the tree dirty and cost the NEXT run all of its overlay
# bumps. Guarded so it can never alter this script's exit code.
commit_ledger() {
  git -C "$FLAKE_DIR" status --porcelain -- overlays/quarantine.json 2>/dev/null | grep -q . || return 0
  git -C "$FLAKE_DIR" add overlays/quarantine.json 2>/dev/null || true
  git -C "$FLAKE_DIR" -c core.hooksPath=/dev/null commit -q -o overlays/quarantine.json \
    -m "quarantine: update ledger" 2>/dev/null || true
  return 0
}
trap 'commit_ledger' EXIT

# ═══════════════════════════════════════════════════════════════════════════
# --activate-only <sha>: the privileged tail. activate -> health -> rollback
# on failure -> mirror on success.
# ═══════════════════════════════════════════════════════════════════════════
run_activate_only() {
  local sha="$1" before

  if [[ -z "$sha" ]]; then
    err "usage: scheduled-check --activate-only <sha>"
    exit 1
  fi
  # Fail cleanly on a missing/non-committed revision, before doing ANYTHING
  # privileged. `activate` itself also validates this, but checking here
  # means a bad sha never even reaches it.
  if ! git -C "$FLAKE_DIR" rev-parse --verify "${sha}^{commit}" >/dev/null 2>&1; then
    err "not a committed revision: $sha"
    notify "nixos-config update FAILED" "activate-only: '$sha' is not a committed revision — nothing activated"
    exit 1
  fi

  # A revision that already failed its health check is quarantined `frozen`.
  # Those entries were previously inert — nothing read them — so the failure
  # repeated daily: health fails on A, we roll back but HEAD stays at A, the
  # next day's bump commits B on top of A, B builds, and activating B
  # re-activates A's breakage. Refuse to activate any descendant of a frozen
  # revision until a human clears the entry.
  while IFS=$'\t' read -r qname qsha; do
    [[ -z "$qsha" ]] && continue
    git -C "$FLAKE_DIR" rev-parse --verify "${qsha}^{commit}" >/dev/null 2>&1 || continue
    if git -C "$FLAKE_DIR" merge-base --is-ancestor "$qsha" "$sha" 2>/dev/null; then
      err "refusing to activate $sha: it contains frozen revision ${qsha:0:7}"
      notify "nixos-config update BLOCKED" \
        "${sha:0:7} contains frozen revision ${qsha:0:7} — clear '$qname' from overlays/quarantine.json after fixing it"
      exit 1
    fi
  done < <(jq -r '.entries[]
                  | select(.kind=="revision")
                  | select(.retry_policy=="frozen")
                  | "\(.name)\t\(.blocked_version)"' \
             "$FLAKE_DIR/overlays/quarantine.json" 2>/dev/null)

  before="$(git rev-parse HEAD 2>/dev/null)"

  # ── Activate ────────────────────────────────────────────────────────────
  if ! "$SCRIPT_DIR/activate" "$sha" >>"$RUN_LOG" 2>&1; then
    notify "nixos-config update FAILED" "activation of ${sha:0:7} failed — see $RUN_LOG"
    exit 1
  fi

  # ── Health check, and roll back if it fails ────────────────────────────
  local health_log="$LOG_DIR/health.log"
  if ! bash "$FLAKE_DIR/scripts/post-activate-health.sh" >"$health_log" 2>&1; then
    cat "$health_log" >>"$RUN_LOG"
    warn "health check failed — rolling back" >>"$RUN_LOG"
    local rolled
    if "$SCRIPT_DIR/rollback" >>"$RUN_LOG" 2>&1; then
      rolled="rolled back"
    else
      rolled="ROLLBACK ALSO FAILED"
    fi
    # Keyed to the revision, not a package: after a multi-package bump the
    # culprit is ambiguous, and re-attribution is a human call, not
    # escalate.sh's job — a revision-level failure is deliberately
    # notify-only, never escalated (the machine is already rolled back and
    # healthy, so there is no urgency and no clear single package to blame).
    quarantine_record "revision-${sha:0:7}" "revision" "$sha" "$before" \
      "health-check" "health-failure" "frozen" "$(tail -40 "$health_log")"
    notify "nixos-config update FAILED" \
      "${sha:0:7} failed health check, $rolled — see $health_log"
    exit 1
  fi

  # ── Mirror to the public repo (only now — invariant 3) ─────────────────
  "$FLAKE_DIR/scripts/sync-to-public.sh" >>"$RUN_LOG" 2>&1 \
    || echo "scheduled-check: public mirror sync failed — see $RUN_LOG" >>"$RUN_LOG"

  # Silent on success (spec §2 "Notification policy") — the run log still
  # records the event so it stays traceable without interrupting the user.
  echo "scheduled-check: activated ${sha:0:7}, healthy" >>"$RUN_LOG"
  exit 0
}

# ═══════════════════════════════════════════════════════════════════════════
# --propose-only (and bare invocation): bump -> escalate -> prepare -> build.
# Never activates.
# ═══════════════════════════════════════════════════════════════════════════
run_propose_only() {
  local exit_code=0
  local before after after_bump changed_paths

  rm -f "$LOG_DIR/proposed-revision"

  before="$(git rev-parse HEAD 2>/dev/null)" || {
    notify "nixos-config update FAILED" "could not determine git HEAD; check the checkout"
    exit 1
  }

  # Snapshot of already-frozen packages, so the "promoted to frozen" alert
  # below fires only for a NEW promotion this run, not on every run forever
  # after the first one.
  local frozen_before
  frozen_before="$(jq -r '[.entries[] | select(.retry_policy=="frozen") | .name] | sort | .[]' \
    "$FLAKE_DIR/overlays/quarantine.json" 2>/dev/null)"

  # ── 1. Overlay bumps (ALL overlays, not just the mechanical subset) ─────
  # The go-source path (bump_gosource) has been implemented and verified by a
  # scoped build for a while; --mechanical-only was excluding it only because
  # c4/hey-cli track branch HEAD. That is now handled by per-package
  # cadence_hours in the manifest, so the flag is no longer needed here.
  "$SCRIPT_DIR/bump-overlays" --no-public-sync >>"$RUN_LOG" 2>&1
  local bump_rc=$?
  if [[ $bump_rc -eq 2 ]]; then
    # Another run holds the lock. Benign — that run owns reporting.
    echo "scheduled-check: lock contention, exiting quietly" >>"$RUN_LOG"
    exit 2
  fi
  if [[ $bump_rc -eq 3 ]]; then
    # overlays/ was dirty, so bump-overlays refused to run and EVERY overlay
    # bump was skipped. Silently continuing here would look like a normal
    # no-bumps day while the whole point of the run quietly did not happen.
    echo "scheduled-check: bump-overlays refused (overlays/ dirty)" >>"$RUN_LOG"
    notify "nixos-config update" \
      "overlay bumps SKIPPED — overlays/ has uncommitted changes; commit or stash them"
  fi
  after_bump="$(git rev-parse HEAD 2>/dev/null)"

  # ── 2. Escalate the packages bump-overlays quarantined this run ─────────
  # Budget: at most 3, one per package (spec §5.2). escalate.sh applies its own
  # fingerprint dedup, so a package failing the same way daily costs one
  # session total, not one per day.
  local escalated=0
  local fixed_by_claude=()
  while IFS=$'\t' read -r qname qver qphase; do
    [[ -z "$qname" ]] && continue
    [[ $escalated -ge 3 ]] && break
    # Do NOT filter on escalation status here. escalate.sh owns dedup and
    # applies the spec's per-(package, fingerprint) rule via
    # quarantine_should_escalate, returning 2 when it declines. A status
    # filter in this jq selector would be a second, coarser rule — it would
    # skip a package after ANY prior gave-up even when the failure signature
    # changed, which is stricter than the spec. Exit 2 must not consume a
    # budget slot; only an actual session does.
    local esc_flag
    esc_flag="$(quarantine_field "$qname" retry_policy)"
    [[ "$esc_flag" == "retry-after:"* ]] && continue   # transient: no repair to make
    local pkg_log="$LOG_DIR/bump-${qname}.log"
    [[ -f "$pkg_log" ]] || pkg_log="$RUN_LOG"
    "$FLAKE_DIR/scripts/escalate.sh" --package "$qname" --version "$qver" \
        --phase "$qphase" --log "$pkg_log" >>"$RUN_LOG" 2>&1
    local esc_rc=$?
    case $esc_rc in
      0) fixed_by_claude+=("$qname"); escalated=$((escalated + 1)) ;;
      1) escalated=$((escalated + 1)) ;;
      2) : ;;  # declined by dedup/ceiling — no session ran, so no slot consumed
    esac
  done < <(jq -r '.entries[]
                  | select(.kind=="overlay")
                  | "\(.name)\t\(.blocked_version)\t\(.phase)"' \
             "$FLAKE_DIR/overlays/quarantine.json")

  # ── 3. Flake inputs (propose) ────────────────────────────────────────────
  # --no-public-sync: nothing may reach the public mirror until the health
  # check passes (invariant 3). prepare's own flake.lock commit would otherwise
  # fire the post-commit hook and publish the whole tracked tree — including
  # the bump commits bump-overlays deliberately withheld — before this run's
  # full system build has even been attempted.
  "$SCRIPT_DIR/prepare" --no-public-sync >>"$RUN_LOG" 2>&1
  local prepare_rc=$?
  if [[ $prepare_rc -eq 2 ]]; then
    echo "scheduled-check: prepare hit lock contention" >>"$RUN_LOG"
  elif [[ $prepare_rc -ne 0 ]]; then
    notify "nixos-config update FAILED" "prepare failed — see $RUN_LOG"
    exit_code=1
  fi

  after="$(git rev-parse HEAD 2>/dev/null)"

  # Frozen/fixed alerts are independent of whether a buildable revision came
  # out of this run — a package can be promoted to frozen (or repaired) purely
  # through ledger-only commits, and that news must not get lost behind an
  # early "nothing changed" return below.
  local frozen_after newly_frozen
  frozen_after="$(jq -r '[.entries[] | select(.retry_policy=="frozen") | .name] | sort | .[]' \
    "$FLAKE_DIR/overlays/quarantine.json" 2>/dev/null)"
  newly_frozen="$(comm -13 <(printf '%s\n' "$frozen_before") <(printf '%s\n' "$frozen_after") 2>/dev/null \
    | paste -sd' ' - 2>/dev/null)"
  if [[ -n "$newly_frozen" ]]; then
    notify "nixos-config: packages frozen" "$newly_frozen — see overlays/quarantine.json"
  fi
  if [[ ${#fixed_by_claude[@]} -gt 0 ]]; then
    notify "nixos-config: Claude repaired an overlay" \
      "${fixed_by_claude[*]} — review 'git log -p' for ${after:0:7}"
  fi

  # Nothing moved: stay completely silent otherwise (invariant 4).
  #
  # "Nothing moved" must also cover the case where the ONLY thing that changed
  # is the quarantine ledger. bump-overlays (and escalate.sh) commit the
  # ledger on every run that records or clears an entry — including a run
  # where every bump FAILED and no package moved at all. Treating that as a
  # real revision would run a full system build and then propose a revision
  # whose entire content is a JSON metadata change. Compare the NET diff
  # across the whole run (bump + escalation + prepare), not just prepare's
  # own commit, since a several-commit run can still net out to ledger-only.
  changed_paths="$(git diff --name-only "$before" "$after" 2>/dev/null)"
  if [[ "$before" == "$after" ]] || [[ "$changed_paths" == "overlays/quarantine.json" ]]; then
    echo "scheduled-check: nothing changed (ledger-only churn ignored)" >>"$RUN_LOG"
    exit $exit_code
  fi

  # ── 4. Full system build as evidence ────────────────────────────────────
  # prepare builds only when it committed something; a bump-only or
  # escalation-only run has had nothing but per-package scoped builds, which
  # cannot catch a system-level eval error or a file collision. Always build
  # here — invariant 2.
  local build_log="$LOG_DIR/system-build.log"
  if ! nix build "${FLAKE_DIR}#${FLAKE_SYSTEM_ATTR}" --out-link ./result >"$build_log" 2>&1; then
    cat "$build_log" >>"$RUN_LOG"
    rm -f ./result
    # A system build that fails after per-package builds passed is a
    # collision or eval problem, not one package's fault — deliberately NOT
    # escalated (spec §3): frozen and reported, and the notification names
    # the range to bisect by hand. Leave the commits in place (a hard reset
    # could discard unrelated work).
    local fp
    fp="$(classify_failure "$build_log" | cut -f1)"
    quarantine_record "revision-${after:0:7}" "revision" "$after" "$before" \
      "system-build" "$fp" "frozen" "$(tail -40 "$build_log")"
    notify "nixos-config update FAILED" \
      "system build failed at ${after:0:7} ($fp) — see $RUN_LOG; 'git reset --hard ${before:0:7}' discards it"
    exit 1
  fi
  {
    echo "==> closure diff (running system -> proposed)"
    nix store diff-closures /run/current-system ./result || true
  } >>"$RUN_LOG" 2>&1
  rm -f ./result

  printf '%s\n' "$after" > "$LOG_DIR/proposed-revision"
  echo "scheduled-check: revision ${after:0:7} built — run 'nix run .#scheduled-check -- --activate-only ${after:0:7}' (or 'nix run .#activate -- ${after:0:7}' by hand)" >>"$RUN_LOG"
  exit $exit_code
}

if [[ "$MODE" == "activate" ]]; then
  run_activate_only "$ACTIVATE_SHA"
else
  run_propose_only
fi
