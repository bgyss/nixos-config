#!/usr/bin/env bash
# "Propose" half of the update pipeline (§5.4): update flake inputs that are
# due (respecting cadence/frozen pins), BUILD the resulting system as
# evidence, and commit — WITHOUT activating anything. Unprivileged; no sudo.
# The privileged switch is a separate step (`activate`) that consumes the
# commit this produces.
#
# Overlay version bumps are NOT performed here: this script only reports
# outdated overlays (informational) and never rewrites an overlay .nix or
# overlays/updates.json. Bumping a pinned overlay version is a manual step —
# see docs/overlay-update-routine.md — because it requires rewriting the
# overlay's pinned version/hash AND updates.json's current_version together;
# doing only the latter here previously produced silently-broken, falsely
# "up to date" state (see git history / final review for details).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/_common.sh"

FLAKE_DIR="$(locate_flake)" || exit 1
cd "$FLAKE_DIR"

# shellcheck source=/dev/null
source "$FLAKE_DIR/scripts/update-state.sh"
# shellcheck source=/dev/null
source "$FLAKE_DIR/scripts/update-probe.sh"
# shellcheck source=/dev/null
source "$FLAKE_DIR/scripts/quarantine.sh"

MANIFEST="${MANIFEST:-$FLAKE_DIR/overlays/updates.json}"

# --no-public-sync: suppress the post-commit mirror hook on the flake.lock
# commit below. `scheduled-check` passes this because it must not publish
# anything until the post-activation health check passes — otherwise a run
# whose full system build later FAILS has already pushed the rejected revision
# to GitHub, while the notification tells the user to `git reset --hard` it.
# A manual `nix run .#prepare` still mirrors normally.
PUBLIC_SYNC=1
_forward_args=()
for _a in "$@"; do
  case "$_a" in
    --no-public-sync) PUBLIC_SYNC=0 ;;
    *) _forward_args+=("$_a") ;;
  esac
done
set -- ${_forward_args+"${_forward_args[@]}"}

# ---8<--- unpin-retry helpers ---8<---
# pinned_inputs[] used to be a permanent freeze: nothing ever retried an
# unpin, so nixpkgs stayed pinned until a human remembered to test it. Each
# pin now carries retry_cadence_hours; a due pin gets ONE speculative bump
# attempt per window, and silently re-freezes if it still fails.

# Exit 0 if <input> is a declared pin whose retry window has elapsed.
unpin_retry_due() { # <input-name>
  local name="$1" cadence last
  cadence="$(jq -r --arg n "$name" \
    '.pinned_inputs[] | select(.name==$n) | .retry_cadence_hours // 168' "$MANIFEST")"
  [[ -z "$cadence" || "$cadence" == "null" ]] && return 1   # not a pin at all
  last="$(quarantine_field "$name" last_attempt)"
  [[ -z "$last" ]] && return 0
  python3 - "$last" "$cadence" <<'PYEOF'
import sys, datetime
last, hours = sys.argv[1], float(sys.argv[2])
try:
    t = datetime.datetime.strptime(last, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
except ValueError:
    sys.exit(0)
# Subtract an hour of slack. The agent fires at a fixed wall-clock time but
# the timestamp is written mid-run, so elapsed is always a few minutes SHORT
# of the nominal window -- a strict >= would defer by a full extra day, every
# time, for any package touched the previous run.
sys.exit(0 if (datetime.datetime.now(datetime.timezone.utc) - t).total_seconds() >= hours * 3600 - 3600 else 1)
PYEOF
}

# Cleanup for the throwaway unpin worktree. Idempotent — safe to call multiple
# times (explicitly at every return path in attempt_unpin below, AND from the
# script's own EXIT trap as a safety net for abnormal termination). Uses
# globals rather than a function-local RETURN trap: this script already owns
# the process's EXIT trap for commit_ledger/state_unlock (see the two-stage
# trap below attempt_unpin's definition), and a second independent trap
# would clobber it rather than compose with it.
# Resolve an input's flake.lock NODE name before reading its rev. The node key
# is NOT the input name in general: when a transitive dependency already claims
# the plain name, nix suffixes ours (`nixpkgs` -> `nixpkgs_2`). In this repo all
# three pinned inputs are suffixed because agenix's own nixpkgs/home-manager/
# darwin take the plain keys, so reading `.nodes[$name]` silently inspects an
# unrelated dependency that `nix flake update <name>` never touches.
#
# .nodes.root.inputs[$n] is normally a string (the node name) but can be an
# array for a `follows` chain; jq then renders it as JSON rather than a node
# name, the node lookup misses, and this returns empty -- which fails closed
# correctly (see callers) but is not a resolved rev, so `follows`-chained
# inputs are not actually handled here.
locked_rev_for_input() { # <flake.lock path> <input-name>
  local lock="$1" name="$2" node
  node="$(jq -r --arg n "$name" '.nodes.root.inputs[$n] // empty' "$lock" 2>/dev/null)"
  [[ -z "$node" ]] && { printf ''; return 0; }
  jq -r --arg node "$node" '.nodes[$node].locked.rev // empty' "$lock" 2>/dev/null
}

cleanup_unpin_worktree() {
  [[ -n "${UNPIN_WT:-}" ]] && git -C "$FLAKE_DIR" worktree remove --force "$UNPIN_WT" >/dev/null 2>&1
  [[ -n "${UNPIN_WT_PARENT:-}" ]] && rm -rf "$UNPIN_WT_PARENT"
  UNPIN_WT=""
  UNPIN_WT_PARENT=""
  return 0
}

# One speculative unpin attempt, verified entirely inside a throwaway git
# worktree at HEAD — the live checkout (flake.nix, flake.lock) is NEVER
# touched. This is deliberate: by the time this runs, probe_flake_inputs
# apply has already run `nix flake lock --update-input` for every due input,
# so the live flake.lock is dirty with THIS RUN's real updates. Writing a
# verified lock back from anywhere else — or `git stash`ing the live tree, as
# the previous implementation did — would collide with those updates and
# destroy them. So on success this function reports what a human should do;
# it never mutates flake.nix/flake.lock/overlays/updates.json itself.
#
# Group-aware: pinned_inputs[] entries sharing the same `unpin_group` are
# COUPLED — nixpkgs, home-manager, and darwin must move together, because
# nix-darwin asserts its release branch matches nixpkgs's, and home-manager's
# services-modular code requires a nixpkgs new enough to provide it. Unpinning
# any one of them alone (the original implementation) verifies a build that
# can never pass: the other two are still rewritten to their OLD pin in the
# same worktree, so the branch-match assertion fails every single time,
# forever, regardless of which coupled member's retry window comes due. So
# when `name` belongs to a group, every member of that group is rewritten,
# `nix flake update`d, and built together in ONE worktree — the whole group
# succeeds or fails as a unit, and every member's ledger entry reflects that
# joint result. An ungrouped pin behaves exactly as before (a group of one).
#
# Exit 0 = the group verifiably builds together against every member's
# unpin_ref, and the human-actionable instructions were printed. Exit 1 = a
# member has no unpin_ref configured, or the attempt failed at some phase
# (recorded in the ledger for every member).
attempt_unpin() { # <input-name>
  local name="$1"
  local group cadence log
  local -a members
  local -A unpin_ref pinned_ref pre_rev post_rev

  group="$(jq -r --arg n "$name" '.pinned_inputs[] | select(.name==$n) | .unpin_group // empty' "$MANIFEST")"
  if [[ -n "$group" ]]; then
    mapfile -t members < <(jq -r --arg g "$group" '.pinned_inputs[] | select(.unpin_group==$g) | .name' "$MANIFEST")
  else
    members=("$name")
  fi

  cadence="$(jq -r --arg n "$name" '.pinned_inputs[] | select(.name==$n) | .retry_cadence_hours // 168' "$MANIFEST")"

  local m
  for m in "${members[@]}"; do
    unpin_ref[$m]="$(jq -r --arg n "$m" '.pinned_inputs[] | select(.name==$n) | .unpin_ref // empty' "$MANIFEST")"
    pinned_ref[$m]="$(jq -r --arg n "$m" '.pinned_inputs[] | select(.name==$n) | .pinned_ref' "$MANIFEST")"
    if [[ -z "${unpin_ref[$m]}" ]]; then
      warn "==> unpin: $m has no unpin_ref configured in pinned_inputs[] — nothing to attempt"
      return 1
    fi
  done

  # What this probe actually tried, as a ledger `blocked_version`. Every other
  # ledger entry keys on the specific upstream artifact that failed, which is
  # what makes a quarantine self-heal: upstream moves -> new blocked_version ->
  # attempts resets -> it is retried. This used to pass the CONSTANT string
  # "unpin-attempt", so the probe's attempts counter could never reset no
  # matter how far upstream moved, and every window's failure incremented it
  # toward the freeze ceiling. Once the target revs are resolved (post-`nix
  # flake update`) they become the blocked_version, so the entry finally means
  # "this exact set of upstream revs failed". Before that point there is
  # nothing resolved to name, so early phases keep the old literal.
  UNPIN_TARGET="unpin-attempt"

  # Record the outcome for every member of the group with the same phase/
  # fingerprint/excerpt — a joint attempt has one joint outcome.
  _unpin_record_group() { # <phase> <fingerprint> <excerpt> -- records EVERY group member
    local phase="$1" fp="$2" excerpt="$3" mm
    for mm in "${members[@]}"; do
      quarantine_record "$mm" "input" "$UNPIN_TARGET" "${pinned_ref[$mm]}" \
        "$phase" "$fp" "retry-after:$cadence" "$excerpt"
    done
  }

  warn "==> speculative unpin attempt: ${members[*]}"
  for m in "${members[@]}"; do
    warn "      $m -> ${unpin_ref[$m]}"
  done
  log="$(mktemp)"

  UNPIN_WT_PARENT="$(mktemp -d)"
  UNPIN_WT="$UNPIN_WT_PARENT/unpin-$(IFS=-; echo "${members[*]}")"
  if ! git -C "$FLAKE_DIR" worktree add -q --detach "$UNPIN_WT" HEAD >"$log" 2>&1; then
    warn "  unpin: could not create a worktree for ${members[*]}"
    _unpin_record_group "flake-update" "unpin-failed" "$(tail -40 "$log")"
    cleanup_unpin_worktree
    rm -f "$log"
    return 1
  fi

  # Step 3: record the PRE-attempt locked rev of every member before touching
  # anything, so the post-update check below can assert each one moved.
  for m in "${members[@]}"; do
    pre_rev[$m]="$(locked_rev_for_input "$UNPIN_WT/flake.lock" "$m")"
  done

  # Step 4: rewrite every member's url in the worktree's flake.nix to its
  # unpin_ref. Anchored on the literal pinned_ref text inside a `url = "..."`
  # value (rather than a fixed `<name>.url = ...` shape) because this repo's
  # inputs use two different shapes — `nixpkgs.url = "..."` / `home-manager.url
  # = "..."` on one line, vs. darwin's `url = "...";` nested inside a `darwin =
  # { ... }` block — and the pinned_ref substring is verified unique across
  # the whole file for each pin. Mirrors bump_version_string in bump-overlays:
  # abort unless exactly one match is found.
  for m in "${members[@]}"; do
    if ! python3 - "$UNPIN_WT/flake.nix" "${pinned_ref[$m]}" "${unpin_ref[$m]}" >>"$log" 2>&1 <<'PYEOF'
import re, sys
path, pinned, new = sys.argv[1], sys.argv[2], sys.argv[3]
text = open(path).read()
pattern = re.compile(r'(url\s*=\s*")([^"]*' + re.escape(pinned) + r'[^"]*)(")')
matches = list(pattern.finditer(text))
if len(matches) != 1:
    print(f"expected exactly 1 url containing {pinned!r} in {path}, found {len(matches)}", file=sys.stderr)
    sys.exit(1)
open(path, "w").write(pattern.sub(lambda m: m.group(1) + new + m.group(3), text))
PYEOF
    then
      warn "  unpin: could not rewrite flake.nix url for $m (pinned_ref not found or ambiguous)"
      _unpin_record_group "flake-update" "unpin-failed" "$(tail -40 "$log")"
      cleanup_unpin_worktree
      rm -f "$log"
      return 1
    fi
  done

  # Step 5: update the lock for every member together, inside the worktree
  # only. Coupled inputs MUST be re-resolved in the same `nix flake update`
  # invocation — updating them one at a time would re-lock each against the
  # others' still-old urls in between.
  if ! ( cd "$UNPIN_WT" && nix flake update "${members[@]}" ) >>"$log" 2>&1; then
    warn "  unpin: 'nix flake update ${members[*]}' failed in the worktree; staying pinned"
    _unpin_record_group "flake-update" "unpin-failed" "$(tail -40 "$log")"
    cleanup_unpin_worktree
    rm -f "$log"
    return 1
  fi

  # Step 6: the load-bearing assertion. A previous implementation declared
  # success here without ever checking whether the rev moved at all — for a
  # rev-pinned url, `nix flake update` re-resolves against the (already
  # rewritten) url and always "succeeds" whether or not anything changed, so
  # skipping this check is exactly how a false "pin can be removed" verdict
  # happened before. Every member must move for the group to count.
  local moved_summary=""
  for m in "${members[@]}"; do
    post_rev[$m]="$(locked_rev_for_input "$UNPIN_WT/flake.lock" "$m")"
    if [[ -z "${pre_rev[$m]}" || -z "${post_rev[$m]}" || "${post_rev[$m]}" == "${pre_rev[$m]}" ]]; then
      warn "  unpin: $m locked rev did not move (still ${pre_rev[$m]}) — treating group as failure"
      _unpin_record_group "flake-update" "unpin-rev-unchanged" \
        "member $m locked rev did not move: ${pre_rev[$m]}"
      cleanup_unpin_worktree
      rm -f "$log"
      return 1
    fi
    moved_summary+="$m ${pre_rev[$m]} -> ${post_rev[$m]}; "
  done

  # Every target rev is now resolved, so the ledger can name what was tried
  # instead of the constant literal — see UNPIN_TARGET above. Short revs keep
  # the string readable; `unpin:` prefixes it so it can never collide with an
  # overlay's version string.
  UNPIN_TARGET="unpin:$(for m in "${members[@]}"; do printf '%s@%s ' "$m" "${post_rev[$m]:0:7}"; done)"
  UNPIN_TARGET="${UNPIN_TARGET% }"

  # Step 7: build in the worktree only, against every member's unpin_ref at
  # once — this is the check that a lone-input attempt could never pass for a
  # coupled group.
  if ! nix build "${UNPIN_WT}#${FLAKE_SYSTEM_ATTR}" --no-link >>"$log" 2>&1; then
    warn "  unpin: system build fails against ${members[*]} unpin refs; staying pinned"
    _unpin_record_group "system-build" "unpin-failed" "$(tail -40 "$log")"
    cleanup_unpin_worktree
    rm -f "$log"
    return 1
  fi

  # Step 9: success. The live tree is untouched — no flake.nix/flake.lock
  # edits, no overlays/updates.json edits. Record the attempt for every member
  # (NOT clear it — quarantine_clear here was the bug that kept the cadence
  # from ever engaging, since last_attempt was never written and
  # unpin_retry_due always read "never attempted, due now") so the cadence
  # actually bounds this expensive path, then print the exact human follow-up.
  msg "  unpin: ${members[*]} verified clean together ($moved_summary)"
  _unpin_record_group "verified" "unpin-verified" \
    "verified together with ${members[*]}; $moved_summary"
  msg "  ==> ACTION REQUIRED to lift the ${members[*]} pin(s) — they must move together:"
  local i=1
  for m in "${members[@]}"; do
    msg "        $i. In flake.nix, replace the pinned url for '$m' with: ${unpin_ref[$m]}"
    i=$((i + 1))
  done
  msg "        $i. Run: nix flake lock"
  i=$((i + 1))
  msg "        $i. Delete the ${members[*]} entries from pinned_inputs[] in overlays/updates.json"
  msg "      (the reason/risk/unpin_when/rollback_hint prose is a human call — not auto-removed)"

  # Hand the verdict to scheduled-check so it can PAGE the operator. Without
  # this the whole mechanism had no terminating action: a healthy scheduled run
  # is silent by design (invariant 4), prepare's stdout goes to the run log, and
  # nobody reads a log that reports success — so a probe that finally passed
  # would keep passing, silently, every week, while the pins stayed forever.
  # A marker file (mirroring logs/proposed-revision) keeps notification policy
  # owned entirely by scheduled-check and leaves prepare unprivileged and
  # side-effect-free against the tracked tree: logs/ is gitignored, so this can
  # never reach a commit or the public mirror.
  mkdir -p "$FLAKE_DIR/logs"
  {
    printf 'unpin verified %s\n' "$(now_iso)"
    printf 'members: %s\n' "${members[*]}"
    printf 'revs: %s\n' "$moved_summary"
    for m in "${members[@]}"; do
      printf 'flake.nix: %s -> %s\n' "$m" "${unpin_ref[$m]}"
    done
  } > "$FLAKE_DIR/logs/unpin-verified"

  cleanup_unpin_worktree
  rm -f "$log"
  return 0
}
# ---8<--- end unpin-retry helpers ---8<---

state_init
# Lock contention is a distinct, benign exit (2): another `prepare` run
# (manual or scheduled) is already in flight. `scheduled-check` treats this
# specially — stay silent rather than fire a FAILED notification — so it
# must never share exit code 1 with a genuine failure.
#
# Commit the quarantine ledger from the EXIT trap, not just at the end of a
# successful run. overlays/quarantine.json lives under overlays/, and
# bump-overlays refuses to start when overlays/ is dirty (exit 3) — so any
# path here that writes the ledger (attempt_unpin below) and exits without
# committing would wedge every future daily run, permanently and silently.
# Guarded so a failure here can never itself fail the script.
commit_ledger() {
  git -C "$FLAKE_DIR" status --porcelain -- overlays/quarantine.json 2>/dev/null | grep -q . || return 0
  git -C "$FLAKE_DIR" add overlays/quarantine.json 2>/dev/null || true
  git -C "$FLAKE_DIR" -c core.hooksPath=/dev/null commit -q -o overlays/quarantine.json \
    -m "quarantine: update ledger" 2>/dev/null || true
  return 0
}
# Register commit_ledger-only first: this process does not hold the state
# lock yet, and unconditionally rmdir-ing it in the trap here would release a
# lock a *different* run legitimately owns. cleanup_unpin_worktree (defined
# above, in the unpin-retry helpers block) is composed into the SAME trap
# rather than given its own, so an abnormal exit mid-attempt_unpin (SIGTERM,
# a partial failure) can never leak the throwaway worktree or its temp parent.
trap 'cleanup_unpin_worktree; commit_ledger' EXIT
if ! state_lock; then err "another update run holds the lock; aborting"; exit 2; fi
# Now that the lock is actually ours, extend the trap to release it too.
trap 'cleanup_unpin_worktree; commit_ledger; state_unlock' EXIT

warn "==> overlay probe"
overlays_outdated="$(probe_overlays)"
warn "==> flake-input probe (apply)"
inputs_updated="$(probe_flake_inputs apply)"

# Overlay version bumps are informational ONLY here — never gate the build
# and never get auto-committed. Auto-bumping the pinned version requires
# rewriting the overlay .nix's URL/hash AND updates.json's current_version
# together (the existing manual routine in docs/overlay-update-routine.md);
# doing only the latter previously left `updates.json` permanently lying
# about what's actually pinned, which also masked the package as "up to
# date" on every subsequent probe. See docs/overlay-update-routine.md.
if [[ -n "$overlays_outdated" ]]; then
  msg "overlays outdated (not auto-updated — see docs/overlay-update-routine.md): $overlays_outdated"
fi

quarantine_init
# Speculative unpin attempts. Each is expensive (a full build against a new
# nixpkgs, in a throwaway worktree), so at most ONE per run: the pins are
# ordered by risk in the manifest and unpinning nixpkgs is what unblocks the
# other two anyway. This MUST run before the "nothing to do" gate below: every
# real flake input (nixpkgs/home-manager/darwin) is permanently frozen via
# pinned_inputs[], and `secrets` is on_demand, so probe_flake_inputs's
# inputs_updated is always empty and the gate would always exit early —
# leaving the unpin retry dead code that never fires. A pin's own retry
# cadence, not other inputs' movement, is what governs whether this runs.
pin_names="$(jq -r '(.pinned_inputs // [])[].name' "$MANIFEST")"
while IFS= read -r pin; do
  [[ -z "$pin" ]] && continue
  if unpin_retry_due "$pin"; then
    if attempt_unpin "$pin"; then
      warn "==> unpin: $pin verified against its tracking ref — see the ACTION REQUIRED message above"
    fi
    break
  fi
done <<< "$pin_names"

# Gate on flake-input movement only; overlays never factor into build/commit.
if ! gate_should_build "" "$inputs_updated"; then
  msg "nothing to do — no flake input moved within cadence"
  state_set_last_gate "$(now_iso)"
  exit 0
fi

state_set_last_gate "$(now_iso)"

warn "==> build ${FLAKE_SYSTEM_ATTR} (evidence; no activation)"
nix build "${FLAKE_DIR}#${FLAKE_SYSTEM_ATTR}" --out-link ./result "$@"

warn "==> closure diff (running system -> proposed)"
nix store diff-closures /run/current-system ./result || true
rm -f ./result

warn "==> commit"
if ! git diff --quiet || ! git diff --cached --quiet; then
  git add flake.lock
  # Under scheduled-check ($PUBLIC_SYNC=0) the post-commit mirror hook is
  # suppressed: publishing happens once, after the health check passes.
  if [[ $PUBLIC_SYNC -eq 1 ]]; then
    git commit -m "flake.lock: Update" \
      --author="$(git config user.name) <$(git config user.email)>"
  else
    git -c core.hooksPath=/dev/null commit -m "flake.lock: Update" \
      --author="$(git config user.name) <$(git config user.email)>"
  fi
  msg "Committed. Proposed revision: $(git rev-parse --short HEAD)"
  msg "Review the closure diff above, then activate with:"
  msg "  nix run .#activate -- $(git rev-parse --short HEAD)"
else
  msg "No changes to commit; already up to date."
fi
