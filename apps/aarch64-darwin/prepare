#!/usr/bin/env bash
# "Propose" half of the update pipeline (§5.4): update flake inputs that are
# due (respecting cadence/frozen pins), BUILD the resulting system as
# evidence, and commit — WITHOUT activating anything. Unprivileged; no sudo.
# The privileged switch is a separate step (`activate`) that consumes the
# commit this produces.
#
# Overlay version bumps are NOT performed here: this script only reports
# outdated overlays (informational) and never rewrites an overlay .nix or
# overlays/updates.json. Bumping a pinned overlay version is a manual step —
# see docs/overlay-update-routine.md — because it requires rewriting the
# overlay's pinned version/hash AND updates.json's current_version together;
# doing only the latter here previously produced silently-broken, falsely
# "up to date" state (see git history / final review for details).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/_common.sh"

FLAKE_DIR="$(locate_flake)" || exit 1
cd "$FLAKE_DIR"

# shellcheck source=/dev/null
source "$FLAKE_DIR/scripts/update-state.sh"
# shellcheck source=/dev/null
source "$FLAKE_DIR/scripts/update-probe.sh"
# shellcheck source=/dev/null
source "$FLAKE_DIR/scripts/quarantine.sh"

MANIFEST="${MANIFEST:-$FLAKE_DIR/overlays/updates.json}"

# ---8<--- unpin-retry helpers ---8<---
# pinned_inputs[] used to be a permanent freeze: nothing ever retried an
# unpin, so nixpkgs stayed pinned until a human remembered to test it. Each
# pin now carries retry_cadence_hours; a due pin gets ONE speculative bump
# attempt per window, and silently re-freezes if it still fails.

# Exit 0 if <input> is a declared pin whose retry window has elapsed.
unpin_retry_due() { # <input-name>
  local name="$1" cadence last
  cadence="$(jq -r --arg n "$name" \
    '.pinned_inputs[] | select(.name==$n) | .retry_cadence_hours // 168' "$MANIFEST")"
  [[ -z "$cadence" || "$cadence" == "null" ]] && return 1   # not a pin at all
  last="$(quarantine_field "$name" last_attempt)"
  [[ -z "$last" ]] && return 0
  python3 - "$last" "$cadence" <<'PYEOF'
import sys, datetime
last, hours = sys.argv[1], float(sys.argv[2])
try:
    t = datetime.datetime.strptime(last, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
except ValueError:
    sys.exit(0)
# Subtract an hour of slack. The agent fires at a fixed wall-clock time but
# the timestamp is written mid-run, so elapsed is always a few minutes SHORT
# of the nominal window -- a strict >= would defer by a full extra day, every
# time, for any package touched the previous run.
sys.exit(0 if (datetime.datetime.now(datetime.timezone.utc) - t).total_seconds() >= hours * 3600 - 3600 else 1)
PYEOF
}

# Cleanup for the throwaway unpin worktree. Idempotent — safe to call multiple
# times (explicitly at every return path in attempt_unpin below, AND from the
# script's own EXIT trap as a safety net for abnormal termination). Uses
# globals rather than a function-local RETURN trap: this script already owns
# the process's EXIT trap for commit_ledger/state_unlock (see the two-stage
# trap below attempt_unpin's definition), and a second independent trap
# would clobber it rather than compose with it.
cleanup_unpin_worktree() {
  [[ -n "${UNPIN_WT:-}" ]] && git -C "$FLAKE_DIR" worktree remove --force "$UNPIN_WT" >/dev/null 2>&1
  [[ -n "${UNPIN_WT_PARENT:-}" ]] && rm -rf "$UNPIN_WT_PARENT"
  UNPIN_WT=""
  UNPIN_WT_PARENT=""
  return 0
}

# One speculative unpin attempt, verified entirely inside a throwaway git
# worktree at HEAD — the live checkout (flake.nix, flake.lock) is NEVER
# touched. This is deliberate: by the time this runs, probe_flake_inputs
# apply has already run `nix flake lock --update-input` for every due input,
# so the live flake.lock is dirty with THIS RUN's real updates. Writing a
# verified lock back from anywhere else — or `git stash`ing the live tree, as
# the previous implementation did — would collide with those updates and
# destroy them. So on success this function reports what a human should do;
# it never mutates flake.nix/flake.lock/overlays/updates.json itself.
#
# Exit 0 = the pin verifiably builds against its tracking ref (unpin_ref) and
# the human-actionable instructions were printed. Exit 1 = no unpin_ref
# configured, or the attempt failed at some phase (recorded in the ledger).
attempt_unpin() { # <input-name>
  local name="$1"
  local unpin_ref pinned_ref cadence log pre_rev post_rev

  unpin_ref="$(jq -r --arg n "$name" '.pinned_inputs[] | select(.name==$n) | .unpin_ref // empty' "$MANIFEST")"
  if [[ -z "$unpin_ref" ]]; then
    warn "==> unpin: $name has no unpin_ref configured in pinned_inputs[] — nothing to attempt"
    return 1
  fi
  pinned_ref="$(jq -r --arg n "$name" '.pinned_inputs[] | select(.name==$n) | .pinned_ref' "$MANIFEST")"
  cadence="$(jq -r --arg n "$name" '.pinned_inputs[] | select(.name==$n) | .retry_cadence_hours // 168' "$MANIFEST")"

  warn "==> speculative unpin attempt: $name -> $unpin_ref"
  log="$(mktemp)"

  UNPIN_WT_PARENT="$(mktemp -d)"
  UNPIN_WT="$UNPIN_WT_PARENT/unpin-$name"
  if ! git -C "$FLAKE_DIR" worktree add -q --detach "$UNPIN_WT" HEAD >"$log" 2>&1; then
    warn "  unpin: could not create a worktree for $name"
    quarantine_record "$name" "input" "unpin-attempt" "$pinned_ref" \
      "flake-update" "unpin-failed" "retry-after:$cadence" "$(tail -40 "$log")"
    cleanup_unpin_worktree
    rm -f "$log"
    return 1
  fi

  # Step 3: record the PRE-attempt locked rev before touching anything, so
  # step 6 below can assert it actually moved.
  pre_rev="$(jq -r --arg n "$name" '.nodes[$n].locked.rev // ""' "$UNPIN_WT/flake.lock")"

  # Step 4: rewrite the input's url in the worktree's flake.nix to unpin_ref.
  # Anchored on the literal pinned_ref text inside a `url = "..."` value
  # (rather than a fixed `<name>.url = ...` shape) because this repo's inputs
  # use two different shapes — `nixpkgs.url = "..."` / `home-manager.url =
  # "..."` on one line, vs. darwin's `url = "...";` nested inside a `darwin =
  # { ... }` block — and the pinned_ref substring is verified unique across
  # the whole file for each of the three pins. Mirrors bump_version_string in
  # bump-overlays: abort unless exactly one match is found.
  if ! python3 - "$UNPIN_WT/flake.nix" "$pinned_ref" "$unpin_ref" >>"$log" 2>&1 <<'PYEOF'
import re, sys
path, pinned, new = sys.argv[1], sys.argv[2], sys.argv[3]
text = open(path).read()
pattern = re.compile(r'(url\s*=\s*")([^"]*' + re.escape(pinned) + r'[^"]*)(")')
matches = list(pattern.finditer(text))
if len(matches) != 1:
    print(f"expected exactly 1 url containing {pinned!r} in {path}, found {len(matches)}", file=sys.stderr)
    sys.exit(1)
open(path, "w").write(pattern.sub(lambda m: m.group(1) + new + m.group(3), text))
PYEOF
  then
    warn "  unpin: could not rewrite flake.nix url for $name (pinned_ref not found or ambiguous)"
    quarantine_record "$name" "input" "unpin-attempt" "$pinned_ref" \
      "flake-update" "unpin-failed" "retry-after:$cadence" "$(tail -40 "$log")"
    cleanup_unpin_worktree
    rm -f "$log"
    return 1
  fi

  # Step 5: update the lock, inside the worktree only.
  if ! ( cd "$UNPIN_WT" && nix flake update "$name" ) >>"$log" 2>&1; then
    warn "  unpin: 'nix flake update $name' failed in the worktree; staying pinned"
    quarantine_record "$name" "input" "unpin-attempt" "$pinned_ref" \
      "flake-update" "unpin-failed" "retry-after:$cadence" "$(tail -40 "$log")"
    cleanup_unpin_worktree
    rm -f "$log"
    return 1
  fi

  # Step 6: the load-bearing assertion. A previous implementation declared
  # success here without ever checking whether the rev moved at all — for a
  # rev-pinned url, `nix flake update` re-resolves against the (already
  # rewritten) url and always "succeeds" whether or not anything changed, so
  # skipping this check is exactly how a false "pin can be removed" verdict
  # happened before.
  post_rev="$(jq -r --arg n "$name" '.nodes[$n].locked.rev // ""' "$UNPIN_WT/flake.lock")"
  if [[ -z "$post_rev" || "$post_rev" == "$pre_rev" ]]; then
    warn "  unpin: $name locked rev did not move (still $pre_rev) — treating as failure"
    quarantine_record "$name" "input" "unpin-attempt" "$pinned_ref" \
      "flake-update" "unpin-rev-unchanged" "retry-after:$cadence" \
      "locked rev did not move: $pre_rev"
    cleanup_unpin_worktree
    rm -f "$log"
    return 1
  fi

  # Step 7: build in the worktree only.
  if ! nix build "${UNPIN_WT}#${FLAKE_SYSTEM_ATTR}" --no-link >>"$log" 2>&1; then
    warn "  unpin: system build fails against $unpin_ref (rev $post_rev); staying pinned"
    quarantine_record "$name" "input" "unpin-attempt" "$pinned_ref" \
      "system-build" "unpin-failed" "retry-after:$cadence" "$(tail -40 "$log")"
    cleanup_unpin_worktree
    rm -f "$log"
    return 1
  fi

  # Step 9: success. The live tree is untouched — no flake.nix/flake.lock
  # edits, no overlays/updates.json edits. Record the attempt (NOT clear it —
  # quarantine_clear here was the bug that kept the cadence from ever
  # engaging, since last_attempt was never written and unpin_retry_due always
  # read "never attempted, due now") so the cadence actually bounds this
  # expensive path, then print the exact human follow-up.
  msg "  unpin: $name verified clean against $unpin_ref (locked rev $pre_rev -> $post_rev)"
  quarantine_record "$name" "input" "unpin-attempt" "$pinned_ref" \
    "verified" "unpin-verified" "retry-after:$cadence" \
    "verified $unpin_ref builds clean; locked rev $pre_rev -> $post_rev"
  msg "  ==> ACTION REQUIRED to lift the '$name' pin:"
  msg "        1. In flake.nix, replace the pinned url for '$name' with: $unpin_ref"
  msg "        2. Run: nix flake lock"
  msg "        3. Delete the '$name' entry from pinned_inputs[] in overlays/updates.json"
  msg "      (the reason/risk/unpin_when/rollback_hint prose is a human call — not auto-removed)"

  cleanup_unpin_worktree
  rm -f "$log"
  return 0
}
# ---8<--- end unpin-retry helpers ---8<---

state_init
# Lock contention is a distinct, benign exit (2): another `prepare` run
# (manual or scheduled) is already in flight. `scheduled-check` treats this
# specially — stay silent rather than fire a FAILED notification — so it
# must never share exit code 1 with a genuine failure.
#
# Commit the quarantine ledger from the EXIT trap, not just at the end of a
# successful run. overlays/quarantine.json lives under overlays/, and
# bump-overlays refuses to start when overlays/ is dirty (exit 3) — so any
# path here that writes the ledger (attempt_unpin below) and exits without
# committing would wedge every future daily run, permanently and silently.
# Guarded so a failure here can never itself fail the script.
commit_ledger() {
  git -C "$FLAKE_DIR" status --porcelain -- overlays/quarantine.json 2>/dev/null | grep -q . || return 0
  git -C "$FLAKE_DIR" add overlays/quarantine.json 2>/dev/null || true
  git -C "$FLAKE_DIR" -c core.hooksPath=/dev/null commit -q -o overlays/quarantine.json \
    -m "quarantine: update ledger" 2>/dev/null || true
  return 0
}
# Register commit_ledger-only first: this process does not hold the state
# lock yet, and unconditionally rmdir-ing it in the trap here would release a
# lock a *different* run legitimately owns. cleanup_unpin_worktree (defined
# above, in the unpin-retry helpers block) is composed into the SAME trap
# rather than given its own, so an abnormal exit mid-attempt_unpin (SIGTERM,
# a partial failure) can never leak the throwaway worktree or its temp parent.
trap 'cleanup_unpin_worktree; commit_ledger' EXIT
if ! state_lock; then err "another update run holds the lock; aborting"; exit 2; fi
# Now that the lock is actually ours, extend the trap to release it too.
trap 'cleanup_unpin_worktree; commit_ledger; state_unlock' EXIT

warn "==> overlay probe"
overlays_outdated="$(probe_overlays)"
warn "==> flake-input probe (apply)"
inputs_updated="$(probe_flake_inputs apply)"

# Overlay version bumps are informational ONLY here — never gate the build
# and never get auto-committed. Auto-bumping the pinned version requires
# rewriting the overlay .nix's URL/hash AND updates.json's current_version
# together (the existing manual routine in docs/overlay-update-routine.md);
# doing only the latter previously left `updates.json` permanently lying
# about what's actually pinned, which also masked the package as "up to
# date" on every subsequent probe. See docs/overlay-update-routine.md.
if [[ -n "$overlays_outdated" ]]; then
  msg "overlays outdated (not auto-updated — see docs/overlay-update-routine.md): $overlays_outdated"
fi

# Gate on flake-input movement only; overlays never factor into build/commit.
if ! gate_should_build "" "$inputs_updated"; then
  msg "nothing to do — no flake input moved within cadence"
  state_set_last_gate "$(now_iso)"
  exit 0
fi

state_set_last_gate "$(now_iso)"

quarantine_init
# Speculative unpin attempts. Each is expensive (a full build against a new
# nixpkgs, in a throwaway worktree), so at most ONE per run: the pins are
# ordered by risk in the manifest and unpinning nixpkgs is what unblocks the
# other two anyway. This runs AFTER the cadence gate above, so it never fires
# on a run where nothing else moved either — but it is independent of that
# gate's outcome otherwise, since a pin's own retry cadence is what governs it.
pin_names="$(jq -r '(.pinned_inputs // [])[].name' "$MANIFEST")"
while IFS= read -r pin; do
  [[ -z "$pin" ]] && continue
  if unpin_retry_due "$pin"; then
    if attempt_unpin "$pin"; then
      warn "==> unpin: $pin verified against its tracking ref — see the ACTION REQUIRED message above"
    fi
    break
  fi
done <<< "$pin_names"

warn "==> build ${FLAKE_SYSTEM_ATTR} (evidence; no activation)"
nix build "${FLAKE_DIR}#${FLAKE_SYSTEM_ATTR}" --out-link ./result "$@"

warn "==> closure diff (running system -> proposed)"
nix store diff-closures /run/current-system ./result || true
rm -f ./result

warn "==> commit"
if ! git diff --quiet || ! git diff --cached --quiet; then
  git add flake.lock
  git commit -m "flake.lock: Update" \
    --author="$(git config user.name) <$(git config user.email)>"
  msg "Committed. Proposed revision: $(git rev-parse --short HEAD)"
  msg "Review the closure diff above, then activate with:"
  msg "  nix run .#activate -- $(git rev-parse --short HEAD)"
else
  msg "No changes to commit; already up to date."
fi
